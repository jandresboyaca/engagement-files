  "cards": [
    {
      "dot": "emerald",
      "title": "Hookable actions (any action of either system)",
      "items": [
        "Publish a template version",
        "Read a template (on engagement creation)",
        "Create an engagement",
        "Open / load an engagement",
        "Apply or decline a decision"
      ]
    },
    {
      "dot": "amber",
      "title": "Stated hard facts",
      "items": [
        "Engagement stores only its creation template id + version",
        "Stored form is not queryable: reading it costs a ~1 min load",
        "Template DB holds no engagement information",
        "All systems live, no maintenance window"
      ]
    },
    {
      "dot": "rose",
      "title": "Not stated (dashed / open)",
      "items": [
        "What 'apply/decline' persists, and whether it updates the stored version",
        "Whether creation reads the DB directly or through the service",
        "Whether a bulk load is side-effect free"
      ]
    },
    {
      "dot": "violet",
      "title": "Loading an engagement (inside Engagement Mgmt)",
      "items": [
        "Runs in the session pods serving that session; ~1 min per file",
        "The engagement is rebuilt in memory, not read: volatile financial fields are computed on load",
        "So engagements cannot be queried in bulk",
        "Pods are shared with live users: any background load competes with real sessions",
        "This load is the slow, capacity-limited downstream of the Part 2 worker"
      ]
    }
  ]
