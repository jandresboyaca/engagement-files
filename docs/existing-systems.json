  "cards": [
    {
      "dot": "cyan",
      "title": "Readers and writers",
      "items": [
        "Template DB — writes: Template Storage System (content-team publish)",
        "Template DB — reads: engagement creation, version diff",
        "Customer DBs — reads and writes: Engagement Mgmt only",
        "Nothing links templates to engagements today"
      ]
    },
    {
      "dot": "amber",
      "title": "Hard facts",
      "items": [
        "Engagement keeps only its creation template id + version",
        "Reading that requires a full load into a pod: ~1 min",
        "Hooks/events may be added to any action of either system",
        "Engagement content is client-confidential"
      ]
    },
    {
      "dot": "rose",
      "title": "Marked as assumption",
      "items": [
        "Zip handling as a distinct step (text: templates are zips of JSON)",
        "One database per customer (text: 'customer-specific databases')",
        "Diff mechanism: given as available, internals unknown"
      ]
    },
    {
      "dot": "violet",
      "title": "Loading an engagement (inside Engagement Mgmt)",
      "items": [
        "Runs in the session pods serving that session; ~1 min per file",
        "The engagement is rebuilt in memory, not read: volatile financial fields are computed on load",
        "So engagements cannot be queried in bulk",
        "Pods are shared with live users: any background load competes with real sessions",
        "This load is the slow, capacity-limited downstream of the Part 2 worker"
      ]
    }
  ]
